#include <stdio.h>
#include <time.h>

int main() {
    int a[10],key,i,c=0;
    clock_t s,e;

    printf("Enter 10 elements: ");
    for(i=0;i<10;i++) scanf("%d",&a[i]);

    printf("Enter target: ");
    scanf("%d",&key);

    s=clock();
    for(i=0;i<10;i++) {
        c++;
        if(a[i]==key) break;
    }
    e=clock();

    if(i<10) printf("Position: %d\n",i+1);
    else printf("Not Found\n");

    printf("Comparisons: %d\n",c);
    printf("Status: %s\n",i<10?"Found":"Not Found");
    printf("Time: %.3f ms",(double)(e-s)*1000/CLOCKS_PER_SEC);
    return 0;
}
