#include <stdio.h>

int main() {
    int a[10][10]={0},v[10]={0},q[10];
    int n,e,x,y,s,f=0,r=0,i,j;

    printf("Vertices and edges: ");
    scanf("%d%d",&n,&e);

    for(i=0;i<e;i++) {
        scanf("%d%d",&x,&y);
        a[x][y]=a[y][x]=1;
    }

    printf("Start vertex: ");
    scanf("%d",&s);

    q[r++]=s; v[s]=1;
    printf("BFS: ");

    while(f<r) {
        x=q[f++];
        printf("%d ",x);
        for(j=0;j<n;j++)
            if(a[x][j] && !v[j]) {
                q[r++]=j;
                v[j]=1;
            }
    }
    return 0;
}
